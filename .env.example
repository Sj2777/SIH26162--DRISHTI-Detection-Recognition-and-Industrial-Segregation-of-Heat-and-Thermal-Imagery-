# ==============================================================================
# AGNI-VISION GEOSPATIAL & INCIDENT RESPONSE PLATFORM CONFIGURATION (TEMPLATE)
# ==============================================================================

# Application Meta
VITE_APP_NAME=AGNI-VISION
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development
VITE_SIMULATION_MODE=true

# NASA FIRMS API (Fire Information for Resource Management System)
# Free registration: https://firms.modaps.eosdis.nasa.gov/api/map_key/
VITE_FIRMS_MAP_KEY=YOUR_NASA_FIRMS_API_KEY_HERE
VITE_FIRMS_API_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv

# EUMETSAT METEOSAT MSG-IODC SEVIRI SATELLITE CONFIGURATION (via eumdac Python SDK)
# Platform: Meteosat-9 / Meteosat-11 (45.5°E Geostationary Orbit)
# Sensor: Spinning Enhanced Visible and InfraRed Imager (SEVIRI)
# Free EUMETSAT registration: https://api.eumetsat.int/api-key
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=
VITE_SEVIRI_ENABLED=true
VITE_SEVIRI_COLLECTION=EO:EUM:DAT:MSG:HRSEVIRI-IODC
VITE_SEVIRI_ORBIT_SLOT=45.5E_GEO
VITE_SEVIRI_SCAN_CADENCE_MIN=15
VITE_SEVIRI_API_URL=/api/seviri/live

# ESA Copernicus Data Space / Sentinel-2 API (Optional)
# Leave blank to use built-in Level-2A worked-example optical validation
VITE_COPERNICUS_API_URL=https://sh.dataspace.copernicus.eu/api/v1/process
VITE_COPERNICUS_CLIENT_ID=
VITE_COPERNICUS_CLIENT_SECRET=

# OpenStreetMap Overpass API (Free public query service, no key required)
VITE_OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Map Basemaps (Optional - System uses 100% free unwatermarked ESRI & OSM tiles by default)
# If you don't have a Carto key, leave blank: the map automatically uses unwatermarked ESRI Dark Canvas
VITE_CARTO_API_KEY=
VITE_MAPBOX_ACCESS_TOKEN=

# India Meteorological Dept (IMD) / Open-Meteo Wind Feed (Free, no key required)
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# National Disaster Management Authority (NDMA) SACHET Gateway (Mock simulation enabled)
VITE_SACHET_GATEWAY_URL=https://sachet.ndma.gov.in/api/v1/cap/dispatch
VITE_SACHET_MOCK_DISPATCH=true

# CPCB Online Continuous Emission Monitoring System Gateway
VITE_CPCB_OCEMS_GATEWAY=https://cpcb.nic.in/ocems/v2
VITE_CPCB_STATUTORY_BASE_RATE=250

# Human-In-The-Loop Incident Commander Emergency PIN
VITE_DEMO_PIN=4491

